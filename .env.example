# BHUMI-X Environment Configuration
# Copy this file to .env and update values as needed

# API Configuration
# Leave empty or set VITE_MOCK_MODE=true for frontend-only development
VITE_API_BASE_URL=
VITE_MOCK_MODE=true

# Map Configuration
# MapLibre style URL - uses OpenStreetMap-based style by default
VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
